{
  "name": "magic-pill",
  "version": "9.0.0",
  "type": "commonjs",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./themes.css": "./dist/themes.css",
    "./magicpill.css": "./dist/styles.css",
    "./dist/magicpill.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "description": "A new way to guide your audience and bring them contextual information through your app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CedricTheveneau/Magic-Pill.git"
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "node scripts/size.mjs"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "keywords": [
    "notifications",
    "magicpill",
    "magic pill",
    "navbar",
    "dynamic island",
    "typescript",
    "react",
    "nextjs",
    "ui",
    "component",
    "toast",
    "navigation"
  ],
  "author": "Cédric THEVENEAU",
  "license": "MIT",
  "homepage": "https://github.com/CedricTheveneau/Magic-Pill#readme",
  "bugs": {
    "url": "https://github.com/CedricTheveneau/Magic-Pill/issues"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "0.23.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "MIGRATING.md",
    "LICENSE.md",
    "NOTICE.md"
  ]
}
